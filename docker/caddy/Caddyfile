http://dragons.local {
	encode zstd gzip

	handle /health {
		respond "ok" 200
	}

	handle {
		respond "dragons services gateway" 200
	}
}

http://airflow.dragons.local {
	encode zstd gzip
	reverse_proxy dragons-airflow-webserver:8080
}

